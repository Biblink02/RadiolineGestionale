# Docker Compose only. Laravel configuration belongs in src/.env.
CONTAINER_NAME=RadiolineGestionale
HOST_USER_UID=1000
HOST_USER_GID=1000
NGINX_PHP_PM_MAX_CHILDREN=10
CONTAINER_NETWORK_SUBNET=192.168.190.0/24
CONTAINER_SERVICE_APP_IP_ADDRESS=192.168.190.3
CONTAINER_SERVICE_DATABASE_IP_ADDRESS=192.168.190.4
DATABASE_BIND_PORT=3306
DATABASE_NAME=RadiolineGestionale
DATABASE_USER=RadiolineGestionale
DATABASE_PASSWORD=change-me
DATABASE_ROOT_PASSWORD=change-me-too
# Production: set the real domain to enable automatic HTTPS.
CADDY_SITE=:80
