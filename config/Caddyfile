{$CADDY_SITE::80} {
	root * /var/www/app/public
	encode zstd gzip

	route {
		@private path /.env* /.git/* /build/manifest.json /build/.vite/*
		respond @private 404

		# Only Laravel's front controller may execute PHP.
		@otherPhp {
			path *.php *.php/*
			not path /index.php /index.php/*
		}
		respond @otherPhp 404

		# Missing assets must return 404 without starting Laravel or a DB session.
		@static path /build/* /images/* /favicons/* /fonts/* /css/* /js/* /storage/* /robots.txt /sitemap.xml
		handle @static {
			@versioned {
				path /build/assets/*
				file
			}
			header @versioned Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle {
			php_fastcgi app:9000
			file_server
		}
	}
}
